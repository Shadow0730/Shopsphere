GOOGLE_ID=your_google_client_id
GOOGLE_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_random_secret
NEXTAUTH_URL=http://localhost:3001

FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_web_app_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace_with_new_private_key\\n-----END PRIVATE KEY-----\\n"

STRIPE_PUBLIC_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_SIGNING_SECRET=your_stripe_webhook_secret
# Optional: create a shipping rate in the current Stripe account before setting this
STRIPE_SHIPPING_RATE_ID=shr_your_shipping_rate_id
HOST=http://localhost:3001

# Optional compatibility aliases used by this project
stripe_public_key=your_stripe_publishable_key
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=your_stripe_publishable_key
